{
    "$schema": "https://opencode.ai/config.json",
    "permission": {
        "edit": "allow",
        "bash": "allow",
        "webfetch": "allow",
        "sardine_submit_feedback": "ask"
    },
    "plugin": [
        "opencode-claude-auth@2.2.1",
        "@datadog/opencode-plugin"
    ],
    "lsp": {
        "java": {
            "disabled": true,
        }
    },
    "mcp": {
        "linear": {
            "type": "remote",
            "url": "https://mcp.linear.app/mcp",
            "enabled": true
        },
        "slack": {
            "type": "remote",
            "url": "https://mcp.slack.com/mcp",
            "enabled": true,
            "oauth": {
                "clientId": "{env:SLACK_MCP_CLIENT_ID}",
                "clientSecret": "{env:SLACK_MCP_CLIENT_SECRET}",
                "scope": "search:read.public search:read.private search:read.mpim search:read.im search:read.users channels:history groups:history mpim:history im:history chat:write"
            }
        },
        "Figma": {
            "enabled": false,
            "type": "remote",
            "url": "https://mcp.figma.com/mcp"
        },
        "mobile-mcp": {
            "type": "local",
            "command": [
                "npx",
                "-y",
                "@mobilenext/mobile-mcp@latest"
            ],
            "enabled": false
        },
        "chrome-devtools": {
            "enabled": false,
            "type": "local",
            "command": [
                "npx",
                "-y",
                "chrome-devtools-mcp@latest",
                "--headless=true",
                "--isolated=true"
            ]
        },
        "chrome-devtools-desktop": {
            "enabled": false,
            "type": "local",
            "command": [
                "npx",
                "-y",
                "chrome-devtools-mcp@latest",
                "--autoConnect"
            ]
        },
        "datadog": {
            "enabled": true,
            "type": "remote",
            "url": "https://mcp.us5.datadoghq.com/v1/mcp?referrer_ide=opencode-plugin&plugin_version=0.7.13",
            "oauth": {}
        },
        "sardine": {
            "type": "remote",
            "url": "https://docs.sardine.ai/authed/mcp",
            "enabled": false,
            "oauth": {
                "scope": "mcp:search"
            },
            "timeout": 10000
        },
    }
}
