#!/usr/bin/env bash
set -euo pipefail

if [ "$#" -gt 1 ]; then
  printf 'Usage: %s [optional-group]\n' "$0" >&2
  exit 1
fi

opencode_dir=$(dirname "$(realpath "${BASH_SOURCE[0]}")")
source_dir="$opencode_dir/skills"

if [ "$#" -eq 1 ]; then
  case "$1" in
    ''|*[!a-zA-Z0-9_-]*)
      printf 'Error: invalid optional skill group: %s\n' "$1" >&2
      exit 1
      ;;
  esac
  source_dir="$opencode_dir/optional-skills/$1"
  if [ ! -d "$source_dir" ]; then
    printf 'Error: unknown optional skill group: %s\n' "$1" >&2
    exit 1
  fi
fi

mkdir -p "$HOME/.config/opencode/skills"
for source in "$source_dir"/*; do
  [ -d "$source" ] || continue
  name=${source##*/}
  target="$HOME/.config/opencode/skills/$name"

  if [ -L "$target" ]; then
    ln -sfn "$source" "$target"
  elif [ -e "$target" ]; then
    printf 'Error: refusing to overwrite existing local OpenCode skill: %s\n' "$target" >&2
    exit 1
  else
    ln -s "$source" "$target"
  fi
done
