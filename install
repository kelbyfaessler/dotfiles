#!/usr/bin/env bash

# vim:
ln -s ~/.dotfiles/nvim ~/.config/nvim

# zsh:
git clone --depth=1 https://github.com/romkatv/powerlevel10k.git ~/.config/zsh/powerlevel10k
ln -s ~/.dotfiles/zsh/.p10k.zsh ~/.p10k.zsh

git clone https://github.com/zsh-users/zsh-autosuggestions ~/.config/zsh/zsh-autosuggestions

git clone https://github.com/zsh-users/zsh-syntax-highlighting.git ~/.config/zsh/zsh-syntax-highlighting

touch ~/.zshrc_local
ln -s ~/.dotfiles/zsh/.zshrc ~/.zshrc

# fzf (can be used with zsh, tmux, nvim. I currently use with zsh)
#mkdir ~/.config/fzf
git clone --depth=1 https://github.com/junegunn/fzf ~/.config/fzf
cd ~/.config/fzf
./install --no-update-rc --no-bash --no-fish

# lazygit configuration
mkdir -p ~/.config/lazygit
ln -s ~/.dotfiles/lazygit/config.yml ~/.config/lazygit/config.yml

# git options
git config --global --add --bool push.autoSetupRemote true
git config --global alias.undo 'reset --soft HEAD^'

# OpenCode skills
mkdir -p "$HOME/.config/opencode/skills"
for source in "$HOME/.dotfiles/opencode/skills"/*; do
  [ -d "$source" ] || continue
  name=${source##*/}
  target="$HOME/.config/opencode/skills/$name"

  if [ -L "$target" ]; then
    ln -sfn "$source" "$target"
  elif [ -e "$target" ]; then
    printf 'Error: refusing to overwrite existing local OpenCode skill: %s\n' "$target" >&2
    exit 1
  else
    ln -s "$source" "$target"
  fi
done
